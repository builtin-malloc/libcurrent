## =============================================================================
## == SETUP ====================================================================
## =============================================================================

NAME     := current
VERSION  := @VERSION@

CORELIBNAME  := lib$(NAME).so
MAINLIBNAME  := lib$(NAME)-main.a

BUILD    := @BUILD@
STRICT   := @STRICT@
VERBOSE  := @VERBOSE@
PLATFORM := @PLATFORM@

ifeq ($(VERBOSE),False)
Q		:= @
ECHO_CC			= @echo "[COMPILE]   $(<F)"
ECHO_LD			= @echo "[LINK]      $(@F)"
ECHO_AR			= @echo "[ARCHIVE]   $(@F)"
ECHO_TAGS       = @echo "[TAGS]"
ECHO_CLEAN      = @echo "[CLEAN]"
ECHO_DISTCLEAN  = @echo "[DISTCLEAN]"
endif

## =============================================================================
## == FILES AND FOLDERS ========================================================
## =============================================================================

INCDIR := @INCDIR@
SRCDIR := @SRCDIR@
OBJDIR := @OBJDIR@
BINDIR := @BINDIR@

CONFIG_H := @CONFIG_H@
MAKEFILE := @MAKEFILE@

CORESRC := $(filter-out $(SRCDIR)/main.c,$(wildcard $(SRCDIR)/*.c))
COREOBJ := $(CORESRC:$(SRCDIR)/%.c=$(OBJDIR)/src/%.o)
COREDEP := $(COREOBJ:.o=.d)
CORELIB := $(BINDIR)/$(CORELIBNAME)
MAINSRC := $(SRCDIR)/main.c
MAINOBJ := $(MAINSRC:$(SRCDIR)/%.c=$(OBJDIR)/src/%.o)
MAINDEP := $(MAINOBJ:.o=.d)
MAINLIB := $(BINDIR)/$(MAINLIBNAME)

## =============================================================================
## == COMPILER =================================================================
## =============================================================================

CC      ?= cc
CCLD    ?= $(CC)
AR      ?= ar

CFLAGS  := -c -g -MMD -std=c99 -fPIC -I$(INCDIR) -Wall -Wextra -Wpedantic @CFLAGS@
LDFLAGS := -L$(BINDIR) @LDFLAGS@
ARFLAGS := rcs

## =============================================================================
## == COMMANDS =================================================================
## =============================================================================

RM_F	:= rm -f
RM_RF	:= rm -rf
CTAGS_R	:= ctags --languages=C --extras=+q --fields=+iaS -R

## =============================================================================
## == TARGETS ==================================================================
## =============================================================================

.PHONY: all

all: build tags

## ========== BUILD

.PHONY: build

build: $(CORELIB) $(MAINLIB)

$(CORELIB): $(COREOBJ)
	$(ECHO_LD)
	$(Q)$(CCLD) -o $@ $(filter %.o,$^) $(LDFLAGS) -shared

$(MAINLIB): $(MAINOBJ)
	$(ECHO_AR)
	$(Q)$(AR) $(ARFLAGS) $@ $^

$(COREOBJ) $(MAINOBJ): $(OBJDIR)/src/%.o: $(SRCDIR)/%.c
	$(ECHO_CC)
	$(Q)$(CC) -o $@ $< $(CFLAGS)

-include $(COREDEP)
-include $(MAINDEP)

## ========== TEST

.PHONY: check

check: $(TESTBIN)
	$<

## ========== INSTALL

.PHONY: install uninstall

install:

uninstall:

## ========== DEVELOP

.PHONY: tags

tags:
	$(ECHO_TAGS)
	$(Q)$(CTAGS_R) $(SRCDIR)

## ========== CLEAN

.PHONY: clean distclean

clean:
	$(ECHO_CLEAN)
	$(Q)$(RM_F) $(CORELIB)
	$(Q)$(RM_F) $(COREOBJ)
	$(Q)$(RM_F) $(COREDEP)
	$(Q)$(RM_F) $(MAINLIB)
	$(Q)$(RM_F) $(MAINOBJ)
	$(Q)$(RM_F) $(MAINDEP)

distclean:
	$(ECHO_DISTCLEAN)
	$(Q)$(RM_RF) $(BINDIR)
	$(Q)$(RM_RF) $(OBJDIR)
	$(Q)$(RM_F)  $(CONFIG_H)
	$(Q)$(RM_F)  $(MAKEFILE)

